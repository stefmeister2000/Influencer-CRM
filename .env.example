# --- AI (recommended for discovery; optional for message scripts) ---
# Without this, discovery returns nothing and scoring/messages use local fallbacks.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# New outreach scripts are template-first by default to reduce API cost.
# template/off = no Claude call for first drafts. ai/claude = use Claude for first drafts.
OUTREACH_MESSAGE_MODE=template

# --- Auth ---
# Secret used to sign the session cookie. MUST be set in production to a long
# random string (otherwise everyone shares an insecure fallback secret).
AUTH_SECRET=change-me-to-a-long-random-string

# --- Discovery ---
# ai = Claude web-search discovery (needs ANTHROPIC_API_KEY). manual | csv = no auto discovery.
DISCOVERY_PROVIDER=ai

# --- Database (SQLite) ---
# Local dev: leave unset -> ./data/orvion.db
# Hosted (Railway/Fly/etc.): the container disk is EPHEMERAL. Attach a persistent
# volume and point this at it, e.g. a Railway volume mounted at /data:
#   DATABASE_PATH=/data/orvion.db
# Without a volume the DB is wiped on every deploy/restart.
DATABASE_PATH=

# --- Optional: Instagram Graph API (for automated discovery of public pro accounts) ---
IG_GRAPH_ACCESS_TOKEN=
IG_GRAPH_BUSINESS_ACCOUNT_ID=
