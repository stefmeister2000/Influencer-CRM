# --- AI (optional but recommended) ---
# Without this, scoring + messages fall back to built-in rule-based/template logic.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# --- Auth ---
# Secret used to sign the local session cookie. Change to any random string.
AUTH_SECRET=change-me-to-a-long-random-string

# --- Optional: Instagram Graph API (for automated discovery of public pro accounts) ---
IG_GRAPH_ACCESS_TOKEN=
IG_GRAPH_BUSINESS_ACCOUNT_ID=

# --- App ---
# Active discovery provider: manual | csv | instagram_graph
DISCOVERY_PROVIDER=manual

# The database is a local SQLite file at ./data/orvion.db — no setup needed.
